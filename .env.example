# Copy this file to .env and fill in real values. .env is gitignored.

# ---- Dune Analytics ----
# Get an API key at https://dune.com/settings/api
DUNE_API_KEY=your_dune_api_key_here

# ---- Google Cloud ----
# Auth uses Application Default Credentials. One-time setup on a new machine:
#   gcloud auth application-default login
#   gcloud config set project dex-research
# No service-account JSON required.
GCP_PROJECT_ID=dex-research
GCS_BUCKET=dex-research-data

# ---- Local paths ----
# Where parquet files are cached locally (mirrors the GCS layout). Gitignored.
DATA_DIR=./data

# Study scope and protocol parameters.
STUDY_CONFIG_PATH=./config/study.yaml
